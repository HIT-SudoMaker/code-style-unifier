# Copy to .env.lumerical and set exact local solver facts.
# ANSYSLMD_LICENSE_FILE may remain empty when inherited from the machine.

LUMERICAL_FDTD_PATH=
LUMERICAL_PYTHON_API_PATH=
LUMERICAL_LICENSE_UTILITY_PATH=
ANSYSLMD_LICENSE_FILE=

METACRAFT_RUNS_DIR=runs
METACRAFT_CAPACITY_FRESHNESS_SECONDS=300

# SMOKE opens the configured installation and reports product, license,
# material read-back, and native construction results.
# SOLVE additionally runs the propagation and geometric observations.
# Run:
# & 'C:\Users\Administrator\miniforge3\envs\research_env\python.exe' `
#   -m pytest -m lumerical_live -vv -rs tests/solvers/test_lumerical_live.py
METACRAFT_RUN_LUMERICAL_SMOKE=0
METACRAFT_RUN_LUMERICAL_SOLVE=0
METACRAFT_LUMERICAL_HEADLESS=1
