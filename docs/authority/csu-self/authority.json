    {"id": "documentation.safety", "family": "documentation", "fact": "callable_documentation", "operator": "documentation_safety", "grade": "hard_violation", "message": "unsafe Rust subject must provide a non-empty # Safety section"},
    {"id": "dependency.wildcard", "family": "dependency", "fact": "dependency_declaration", "operator": "dependency_wildcard", "grade": "hard_violation", "message": "wildcard dependency binding is forbidden"},
    {"id": "dependency.module_placement", "family": "dependency", "fact": "dependency_declaration", "operator": "dependency_module_placement", "grade": "hard_violation", "message": "C++ module import must precede ordinary top-level declarations"},
    {"id": "dependency.order", "family": "dependency", "fact": "dependency_declaration", "operator": "dependency_order", "grade": "hard_violation", "message": "dependencies must follow the language-local canonical order"}
